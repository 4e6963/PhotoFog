{
  "workspace": ["./web"],
  "unstable": ["kv", "cron"],
  "tasks": {
    "dev": {
      "description": "Run API server and Vite dev server in parallel",
      "dependencies": ["dev:server", "dev:web"]
    },
    "dev:server": "DEBUG=1 deno run --watch=server/,shared/ --allow-net --allow-env --allow-read --allow-write=./data server/main.ts",
    "dev:web": "deno run -A npm:vite --config web/vite.config.ts",
    "build": "deno run -A npm:vite build --config web/vite.config.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write=./data server/main.ts",
    "test": "deno test --allow-read --allow-env shared/ server/ web/src/",
    "check": "deno check server/main.ts shared/ && deno check web/src/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "hono": "jsr:@hono/hono@^4.13",
    "@negrel/webpush": "jsr:@negrel/webpush@^0.5"
  },
  "fmt": { "lineWidth": 100 },
  "exclude": ["web/dist", "node_modules", "data"]
}
